# Skopiruj tento subor ako .env.local a doplnaj postupne.
# Aplikacia bezi aj bez tychto premennych — chybajuce integracie sa
# len zaloguju do konzoly namiesto odoslania. Formular sa da testovat hned.
#
# Rovnake hodnoty potom patria aj do Vercelu:
# Project -> Settings -> Environment Variables.

# ---- n8n (leady) -----------------------------------------------------
# TOTO JE HLAVNA A JEDINA POVINNA INTEGRACIA.
#
# Stranka posle na tento webhook jeden JSON a workflow v n8n sa uz
# postara o zvysok: zapis do NocoDB (tabulka Leady_Peter_Samal) a
# e-maily. Vdaka tomu, ze je to tá ista tabulka ako pri leadoch z
# Facebooku, plati pre leady zo stranky aj Petrova pripomienka
# nekontaktovanych leadov a tlacidla na zmenu stavu z e-mailu.
#
# Workflow: "SPerformance — Lead Capture"
# Production URL najdes v jeho uzle "Webhook".
N8N_WEBHOOK_URL=

# Webhook je verejna adresa — kto ju uhadne, moze Petrovi do tabulky
# pisat vymyslene leady. Toto tajomstvo posiela stranka v hlavicke
# x-webhook-secret a webhook ho overuje cez credential "Header Auth".
N8N_WEBHOOK_SECRET=

# ---- E-maily cez Resend (ZALOHA, volitelne) --------------------------
# Normalne e-maily posiela n8n. Toto je zalozna cesta — ked su zapnute
# obe naraz, e-mail pride DVAKRAT. Ked posiela n8n, nechaj prazdne.
RESEND_API_KEY=
MAIL_FROM="SPerformance <noreply@TVOJA-DOMENA.sk>"
MAIL_TO=

# ---- Meta Pixel + Conversions API ------------------------------------
# ID pixela je v kode (src/lib/content.ts, META_PIXEL_ID) — nie je tajne,
# prehliadac ho musi dostat. Tieto premenne ho vedia prebit, napriklad
# pri testovani s inym pixelom.
#
# CAPI TOKEN je naopak tajny a patri IBA sem.
# POZOR: udalost Lead sa posiela IBA pri kvalifikovanom leade.
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
NEXT_PUBLIC_META_PIXEL_ID=
