# Skopiruj tento subor ako .env.local a doplnaj postupne.
# Aplikacia bezi aj bez tychto premennych — chybajuce integracie sa
# len zaloguju do konzoly namiesto odoslania. Formular sa da testovat hned.

# ---- Google Sheets (leady) -------------------------------------------
# 1. console.cloud.google.com -> novy projekt -> zapni Google Sheets API
# 2. vytvor servisny ucet, stiahni JSON kluc
# 3. zdielaj cielovu tabulku s e-mailom servisneho uctu (pravo Editor)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Leady

# ---- E-maily (Resend) ------------------------------------------------
# resend.com -> API key. Domenu webpointsk.com over cez DNS zaznamy,
# inak budu maily koncit v spame.
RESEND_API_KEY=
MAIL_FROM="WebPoint <noreply@webpointsk.com>"
MAIL_TO=

# ---- Notifikacia na telefon (Telegram) -------------------------------
# @BotFather -> /newbot -> token. CHAT_ID zistis cez @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Meta Pixel + Conversions API ------------------------------------
# Doplni sa az ked bude Pixel vytvoreny v Business Manageri.
# POZOR: udalost Lead sa posiela IBA pri kvalifikovanom leade.
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
